# Copie este arquivo para .env e ajuste os valores.
# O arquivo .env não é versionado (está no .gitignore).

# Versão da imagem Docker a ser implantada (tag publicada no GHCR)
IMAGE_TAG=latest

# Porta da máquina onde a API ficará disponível
APP_PORT=8000

# Nível de log da aplicação: DEBUG, INFO, WARNING ou ERROR
LOG_LEVEL=INFO
